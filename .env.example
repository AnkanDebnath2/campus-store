DJANGO_SECRET_KEY=replace-with-a-unique-local-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

MYSQL_NAME=catalog_db
MYSQL_AUTH_NAME=auth_db
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# The Django alias remains orders_db; Neon uses the actual database name neondb.
POSTGRES_NAME=neondb
POSTGRES_USER=replace-with-neon-user
POSTGRES_PASSWORD=replace-with-neon-password
POSTGRES_HOST=replace-with-neon-host
POSTGRES_PORT=5432

MONGO_URI=replace-with-mongodb-connection-string
MONGO_DB_NAME=activity_db
MONGO_COLLECTION=view_logs
